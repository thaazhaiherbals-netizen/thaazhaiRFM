# Template only. Copy to .env.production for an explicitly selected production run.
# On Render, set these in the service environment instead of uploading this file.
DATABASE_URL=
CORS_ORIGINS=["https://YOUR-WEB-SERVICE.onrender.com"]
# Reserved for future integrations; not required by the current PostgreSQL backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret for admin API requests; never expose in NEXT_PUBLIC variables.
ADMIN_API_TOKEN=

# Reserved for the planned read-only Meta Marketing API integration.
# Set secrets in Render, never in a committed file. Not consumed yet.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_SYNC_START_DATE=
META_SYNC_LOOKBACK_DAYS=7
META_ATTRIBUTION_WINDOWS=["7d_click","1d_view"]
META_ACTION_REPORT_TIME=conversion
