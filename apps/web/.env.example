# Public address is optional for links. API_URL is used by the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
# Same server-only API token configured for FastAPI. Never prefix with NEXT_PUBLIC.
ADMIN_API_TOKEN=
# Independent long random value used to derive the HTTP-only UI session cookie.
ADMIN_UI_SESSION=
NEXT_PUBLIC_APP_ENV=development
